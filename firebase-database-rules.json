{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid || data.child('whiteUid').val() === auth.uid || data.child('blackUid').val() === auth.uid || newData.child('whiteUid').val() === auth.uid || newData.child('blackUid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['creatorUid','whiteUid','active','state','stateVersion']) && newData.child('creatorUid').isString() && newData.child('whiteUid').isString() && newData.child('active').isBoolean() && newData.child('stateVersion').isNumber())",
        "spectators": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('active').val() === true",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        },
        "chat": {
          "$message": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && (data.parent().parent().child('whiteUid').val() === auth.uid || data.parent().parent().child('blackUid').val() === auth.uid || data.parent().parent().child('spectators').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['uid','text','createdAt']) && newData.child('uid').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 300 && newData.child('createdAt').isNumber()"
          }
        },
        "mutes": {
          "$playerUid": {
            "$mutedUid": {
              ".write": "auth != null && auth.uid === $playerUid && (data.parent().parent().parent().child('whiteUid').val() === auth.uid || data.parent().parent().parent().child('blackUid').val() === auth.uid)",
              ".validate": "!newData.exists() || newData.val() === true"
            }
          }
        }
      }
    }
  }
}
